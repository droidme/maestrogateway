# Copy this file to .env and adjust. Docker Compose reads it automatically.

# MQTT broker (MQTT 5 capable, e.g. Mosquitto 2.x or the Home Assistant Mosquitto add-on)
MAESTRO_MQTT_BROKER_URL=tcp://192.168.1.10:1883
MAESTRO_MQTT_USERNAME=
MAESTRO_MQTT_PASSWORD=
MAESTRO_MQTT_CLIENT_ID=mcz-stove

# TOPIC (one topic per value) or JSON (single JSON document)
MAESTRO_MQTT_PAYLOAD_TYPE=TOPIC
MAESTRO_MQTT_PUBLISH_PREFIX=Maestro
MAESTRO_MQTT_COMMAND_PREFIX=Maestro/Command
MAESTRO_MQTT_QOS=1

# Stove WebSocket endpoint (the stove's own access point)
MAESTRO_STOVE_AUTO_CONNECT=true
MAESTRO_STOVE_HOST=192.168.120.1
MAESTRO_STOVE_PORT=81
MAESTRO_STOVE_POLL_INTERVAL_MS=15000

# Home Assistant MQTT discovery
MAESTRO_HOME_ASSISTANT_ENABLED=true
MAESTRO_HOME_ASSISTANT_DISCOVERY_PREFIX=homeassistant
MAESTRO_HOME_ASSISTANT_DEVICE_ID=mcz_stove
MAESTRO_HOME_ASSISTANT_DEVICE_NAME=MCZ Stove

# Actuator
SERVER_PORT=8080
TZ=Europe/Amsterdam
